[22.481006, "o", "\r\n  \u001b[1m── metaphlan_profile  \u001b[0m\r\n"]
[22.481116, "o", "     Per-sample taxonomic relative-abundance profile.\r\n"]
[22.481219, "o", "     \u001b[2mkeyword:\u001b[0m profile\r\n"]
[22.481391, "o", "     \u001b[2mfind:\u001b[0m    \u001b[1m{\u001b[0m\u001b[32m'filename'\u001b[0m: \u001b[32m'*_profile.txt'\u001b[0m, \u001b[32m'path_glob_alt'\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m]\u001b[0m\u001b[1m}\u001b[0m\r\n"]
[22.481595, "o", "     \u001b[2mcolumns:\u001b[0m clade_name:String, NCBI_tax_id:String, relative_abundan\u001b[1;92mce:F\u001b[0mloat64, \r\nadditional_species:String\r\n"]
[22.481837, "o", "     \u001b[2mrender:\u001b[0m  advanced_viz:stacked_taxonomy  \u001b[33mroles\u001b[0m=\u001b[1m{\u001b[0m\u001b[32m'sample_id'\u001b[0m: \u001b[32m'sample_id'\u001b[0m, \u001b[32m'taxon'\u001b[0m: \u001b[32m'taxon'\u001b[0m, \r\n\u001b[32m'rank'\u001b[0m: \u001b[32m'rank'\u001b[0m, \u001b[32m'abundance'\u001b[0m: \u001b[32m'relative_abundance'\u001b[0m\u001b[1m}\u001b[0m\r\n"]

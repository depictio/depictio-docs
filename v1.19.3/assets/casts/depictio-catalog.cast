[22.47998, "o", "\u001b[1;35mMetaPhlAn\u001b[0m  \u001b[1m(\u001b[0m\u001b[36mmetaphlan\u001b[0m\u001b[1m)\u001b[0m\r\n"]
[22.480371, "o", "  Identify clades \u001b[1m(\u001b[0mphyla to species\u001b[1m)\u001b[0m present in the metagenome obtained from a microbiome sample and\r\ntheir relative abundance.\r\n"]
[22.480576, "o", "  \u001b[2mhomepage:\u001b[0m  \u001b[4;94mhttps://huttenhower.sph.harvard.edu/metaphlan/\u001b[0m\r\n"]

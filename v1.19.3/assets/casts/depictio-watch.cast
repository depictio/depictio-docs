[36.746787, "o", "\u001b[3m                                            Sample Rows                                             \u001b[0m\r\n┏━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━━━━┳━━━━━━━━┳━━━━━━━━━┳━━━━━━━━┳━━━━━━━━┳━━━━━━┳━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mindivi\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mbill_l\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mbill_d\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mflippe\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m         \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mdepict\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1maggrega\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m        \u001b[0m┃\u001b[1m        \u001b[0m┃\u001b[1m      \u001b[0m┃\u001b[1m        \u001b[0m┃\r\n┃\u001b[1m \u001b[0m\u001b[1mdual_i\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mength_\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mepth_m\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mr_leng\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mbody_ma\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mio_run\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mtion_ti\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m        \u001b[0m┃\u001b[1m        \u001b[0m┃\u001b[1m      \u001b[0m"]

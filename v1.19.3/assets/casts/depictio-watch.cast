[36.737876, "o", "\u001b[3m       Join Preview: penguins_complete       \u001b[0m\r\n┏━━━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mMetric     \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mLeft DC\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mRight DC\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mJoined\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━╇━━━━━━━━━╇━━━━━━━━━━╇━━━━━━━━┩\r\n│\u001b[36m \u001b[0m\u001b[36mRows       \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m342    \u001b[0m\u001b[32m \u001b[0m│\u001b[34m \u001b[0m\u001b[34m342     \u001b[0m\u001b[34m \u001b[0m│\u001b[35m \u001b[0m\u001b[35m342   \u001b[0m\u001b[35m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mColumns    \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m7      \u001b[0m\u001b[32m \u001b[0m│\u001b[34m \u001b[0m\u001b[34m7       \u001b[0m\u001b[34m \u001b[0m│\u001b[35m \u001b[0m\u001b[35m11    \u001b[0m\u001b[35m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mUnique Keys\u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m342    \u001b[0m\u001b[32m \u001b[0m│\u001b[34m \u001b[0m\u001b[34m342     \u001b[0m\u001b[34m \u001b[0m│\u001b[35m \u001b[0m\u001b[35m342   \u001b[0m\u001b[35m \u001b[0m│\r\n└─────────────┴"]

[27.039168, "o", "           \u001b[48;5;99m   \u001b[0m\u001b[38;5;99m▄▄\u001b[0m                                                   \r\n       \u001b[38;5;134m▄▄▄\u001b[0m \u001b[48;5;99m     \u001b[0m\u001b[38;5;99m▀\u001b[0m                                                  \r\n      \u001b[48;5;134m    \u001b[0m \u001b[48;5;99m   \u001b[0m\u001b[38;5;99m▀\u001b[0m                                                    \r\n       \u001b[38;5;134m▀\u001b[0m\u001b[48;5;134m  \u001b[0m \u001b[48;5;99m \u001b[0m\u001b[38;5;99m▀\u001b[0m \u001b[38;5;69m▄\u001b[0m\u001b[48;5;69m  \u001b[0m    \u001b[1;38;5;98mdepictio\u001b[0m\u001b[2m 1.14.0\u001b[0m                               \r\n      \u001b[48;5;168m  \u001b[0m    \u001b[38;5;69m▄\u001b[0m\u001b[48;5;69m     \u001b[0m   Interactive dashboards for bioinformatics data\r\n\u001b[38;5;74m▄▄▄▄▄▄▄▄\u001b[0m    \u001b[38;5;209m▄▄▄▄▄▄\u001b[0m                                                 \r\n\u001b[48;5;74m      \u001b[0m\u001b[38;5;74m▀\u001b[0m \u001b[38;5;149m▄▄\u001b[0m \u001b[48;5;221m \u001b[0m\u001b[38;5;221m▄\u001b[0m\u001b[38;5;209m▀\u001b[0m\u001b[48;5;209m   \u001b[0m\u001b[38;5;209m▀\u001b[0m                                                 \r\n \u001b[48;5;74m   \u001b[0m\u001b[38;5;74m▀\u001b[0m \u001b[38;5;149m▄\u001b[0m\u001b[48;5;149m"]
[27.039202, "o", "   \u001b[0m \u001b[38;5;221m▀▀\u001b[0m  \u001b[38;5;209m▀▀\u001b[0m                                                  \r\n  \u001b[38;5;74m▀\u001b[0m   \u001b[38;5;149m▀▀\u001b[0m\u001b[48;5;149m  \u001b[0m                                                         \r\n"]
[27.039296, "o", "\r\n"]
[27.05189, "o", "\u001b[1;38;5;98mGet started\u001b[0m\r\n"]
[27.051976, "o", "  Start a server on this machine, with example dashboards\r\n"]
[27.052025, "o", "    \u001b[2m$ \u001b[0m\u001b[38;5;32mdepictio local up\u001b[0m\r\n"]
[27.052082, "o", "  Build dashboards on it from a pipeline's results\r\n"]
[27.052146, "o", "    \u001b[2m$ \u001b[0m\u001b[38;5;32mdepictio ingest <results dir> --server local\u001b[0m\r\n"]
[27.052211, "o", "  Check that the CLI reaches it and its storage\r\n"]
[27.052262, "o", "    \u001b[2m$ \u001b[0m\u001b[38;5;32mdepictio config check --server local\u001b[0m\r\n"]
[27.052295, "o", "\r\n"]
[27.052397, "o", "\u001b[2mAll commands   \u001b[0m\u001b[38;5;32mdepictio --help\u001b[0m\r\n"]

[18.627325, "o", "\u001b[1mRecipe:\u001b[0m sylph/ani.py\r\n"]
[18.628486, "o", "\u001b[1mDescription:\u001b[0m sylph per-genome containment: ANI against abundance and coverage.\r\n\r\n``sylph profile`` reports, for every reference genome it detects in a sample, the\r\nadjusted ANI of the containment match together with the taxonomic and sequence\r\nabundances and the effective coverage. Read-count profilers cannot express this: ANI\r\nsays how close the reads are to the reference the abundance is attributed to, so a\r\nhigh-abundance \u001b[35m/\u001b[0m low-ANI genome marks a confident-looking call that is really a\r\ndivergent relative.\r\n\r\nThe sample identifier is a column of the file itself \u001b[1m(\u001b[0m``Sample_file``\u001b[1m)\u001b[0m, so a glob over\r\nthe per-sample tables keeps its per-sample resolution.\r\n\r\nOutput: sample, genome, contig_name, taxonomic_abundance, abundance_frac,\r\nsequence_abundance, adjusted_ani, naive_ani, eff_cov, median_cov, containment_frac,\r\nkmers_reassigned.\r\n"]
[18.629063, "o", "\u001b[3m          Sources (1)          \u001b[0m\r\n╭─────────┬──────────┬────────╮\r\n│\u001b[1;35m \u001b[0m\u001b[1;35mSource \u001b[0m\u001b[1;35m \u001b[0m│\u001b[1;35m \u001b[0m\u001b[1;35mLocation\u001b[0m\u001b[1;35m \u001b[0m│\u001b[1;35m \u001b[0m\u001b[1;35mFormat\u001b[0m\u001b[1;35m \u001b[0m│\r\n├─────────┼──────────┼────────┤\r\n│\u001b[36m \u001b[0m\u001b[36mprofile\u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mNone    \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mtsv   \u001b[0m\u001b[36m \u001b[0m│\r\n╰─────────┴──────────┴────────╯\r\n"]
[18.6297, "o", "\u001b[3mInput schema: profile (4 columns)\u001b[0m\r\n╭─────────────────────┬─────────╮\r\n│\u001b[1;35m \u001b[0m\u001b[1;35mColumn             \u001b[0m\u001b[1;35m \u001b[0m│\u001b[1;35m \u001b[0m\u001b[1;35mType   \u001b[0m\u001b[1;35m \u001b[0m│\r\n├─────────────────────┼─────────┤\r\n│\u001b[36m \u001b[0m\u001b[36mSample_file        \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mString \u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mGenome_file        \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mString \u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mTaxonomic_abundance\u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mAdjusted_ANI       \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n╰─────────────────────┴─────────╯\r\n"]
[18.6311, "o", "\u001b[3m   Output schema (12 columns)    \u001b[0m\r\n╭─────────────────────┬─────────╮\r\n│\u001b[1;35m \u001b[0m\u001b[1;35mColumn             \u001b[0m\u001b[1;35m \u001b[0m│\u001b[1;35m \u001b[0m\u001b[1;35mType   \u001b[0m\u001b[1;35m \u001b[0m│\r\n├─────────────────────┼─────────┤\r\n│\u001b[36m \u001b[0m\u001b[36msample             \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mString \u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mgenome             \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mString \u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mcontig_name        \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mString \u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mtaxonomic_abundance\u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mabundance_frac     \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36msequence_abundance \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36madjusted_ani       \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36"]
[18.631119, "o", "m \u001b[0m\u001b[36mnaive_ani          \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36meff_cov            \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mmedian_cov         \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mcontainment_frac   \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mFloat64\u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mkmers_reassigned   \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mInt64  \u001b[0m\u001b[36m \u001b[0m│\r\n╰─────────────────────┴─────────╯\r\n"]

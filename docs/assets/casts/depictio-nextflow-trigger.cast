[21.405002, "o", "manifest {\r\n    name    = 'depictio/nextflow-trigger-example'\r\n    version = '0.1.0'\r\n}\r\n\r\nparams {\r\n    outdir = 'results'\r\n    // No bundled template for this pipeline: name its project and dashboard YAML\r\n    depictio_project_config = \"${projectDir}/depictio_project.yaml\"\r\n    depictio_dashboard      = \"${projectDir}/depictio_dashboard.yaml\"\r\n}\r\n"]

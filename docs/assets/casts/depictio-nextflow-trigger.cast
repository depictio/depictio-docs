[7.951077, "o", "\u001b[1;32m✓\u001b[0m Copied the handler to ~/.depictio/nextflow.config\r\n"]
[7.951189, "o", "\u001b[1;32m✓\u001b[0m Enabled it for every pipeline in ~/.nextflow/config\r\n"]
[7.951311, "o", "\u001b[1;34m•\u001b[0m `nextflow run <pipeline>` now triggers Depictio with no extra flag. Add --depictio_enabled false to skip a given run, or undo with: depictio config nextflow --uninstall\r\n"]

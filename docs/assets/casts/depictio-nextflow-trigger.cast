[9.231979, "o", "\u001b[1;32m✓\u001b[0m Copied the handler to ~/.depictio/nextflow.config\r\n"]
[9.232092, "o", "\u001b[1;32m✓\u001b[0m Installed opt-in in ~/.nextflow/config: pipelines stay silent by default.\r\n"]
[9.232208, "o", "\u001b[1;34m•\u001b[0m Add --depictio_enabled true to a `nextflow run` to trigger Depictio for it, or undo the install with: depictio config nextflow --uninstall\r\n"]

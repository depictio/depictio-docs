[23.244985, "o", "\u001b[94m╭─\u001b[0m\u001b[94m \u001b[0m\u001b[36mCommand Used\u001b[0m\u001b[94m \u001b[0m\u001b[94m─╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mingest\u001b[0m         \u001b[94m│\u001b[0m\r\n\u001b[94m╰────────────────╯\u001b[0m\r\n"]
[23.245114, "o", "\u001b[1;34m•\u001b[0m DRY RUN MODE - No actual operations will be performed\r\n"]
[23.245367, "o", "\u001b[94m╭─────────────────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 1/8: Checking server accessibility\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰─────────────────────────────────────────╯\u001b[0m\r\n"]
[23.2489, "o", "\u001b[1;34m•\u001b[0m Server: http://127.0.0.1:8058 (local server, as no ~/.depictio/CLI.yaml exists; configuration ~/.depictio/local/cli/admin_config.yaml)\r\n"]
[23.249142, "o", "\u001b[1;34m•\u001b[0m Would check that this server answers\r\n"]
[23.249379, "o", "\u001b[94m╭─────────────────────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 2/8: Checking S3 storage configuration\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰─────────────────────────────────────────────╯\u001b[0m\r\n"]
[23.249481, "o", "\u001b[1;34m•\u001b[0m Would check the S3 storage configuration\r\n"]
[23.249615, "o", "\u001b[94m╭────────────────────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 3/8: Validating project configuration\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰────────────────────────────────────────────╯\u001b[0m\r\n"]
[23.261891, "o", "\u001b[1;32m✓\u001b[0m Project configuration is valid (checked locally; a dry run does not contact the server)\r\n"]
[23.262084, "o", "\u001b[94m╭───────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 4/8: Syncing project configuration to server\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰───────────────────────────────────────────────────╯\u001b[0m\r\n"]
[23.262174, "o", "\u001b[1;34m•\u001b[0m Would create project 'Palmer Penguins Field Runs' on the server, or refresh it in place\r\n"]
[23.262321, "o", "\u001b[94m╭───────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 5/8: Scanning data files\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰───────────────────────────────╯\u001b[0m\r\n"]
[23.263626, "o", "\u001b[3m         Dry run: files each data collection would match         \u001b[0m\r\n╭───────────────────┬───────────┬───────────────────────┬───────╮\r\n│\u001b[1;35m \u001b[0m\u001b[1;35mdata collection  \u001b[0m\u001b[1;35m \u001b[0m│\u001b[1;35m \u001b[0m\u001b[1;35mscan mode\u001b[0m\u001b[1;35m \u001b[0m│\u001b[1;35m \u001b[0m\u001b[1;35mpattern              \u001b[0m\u001b[1;35m \u001b[0m│\u001b[1;35m \u001b[0m\u001b[1;35mfiles\u001b[0m\u001b[1;35m \u001b[0m│\r\n├───────────────────┼───────────┼───────────────────────┼───────┤\r\n│\u001b[36m \u001b[0m\u001b[36mphysical_features\u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mrecursive\u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mphysical_features.csv\u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36m3    \u001b[0m\u001b[36m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mdemographic_data \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mrecursive\u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mdemographic_data.csv \u001b[0m\u001b[36m \u001b[0m│\u001b[36m \u001b[0m\u001b[36m"]
[23.26364, "o", "3    \u001b[0m\u001b[36m \u001b[0m│\r\n╰───────────────────┴───────────┴───────────────────────┴───────╯\r\n"]
[23.263742, "o", "\u001b[1;34m•\u001b[0m Would scan the data files\r\n"]
[23.263903, "o", "\u001b[94m╭───────────────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 6/8: Processing data collections\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰───────────────────────────────────────╯\u001b[0m\r\n"]
[23.263976, "o", "\u001b[1;34m•\u001b[0m Would process the data collections\r\n"]
[23.264135, "o", "\u001b[94m╭─────────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 7/8: Executing table joins\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰─────────────────────────────────╯\u001b[0m\r\n"]
[23.264202, "o", "\u001b[1;34m•\u001b[0m Would run 1 table join(s)\r\n"]
[23.264335, "o", "\u001b[94m╭────────────────────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mStep 8/8: Importing dashboards\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰────────────────────────────────╯\u001b[0m\r\n"]
[23.264402, "o", "\u001b[1;34m•\u001b[0m Would import 1 dashboard(s), keeping those the project already has\r\n"]
[23.264532, "o", "\u001b[94m╭───────────────────╮\u001b[0m\r\n\u001b[94m│\u001b[0m \u001b[1;35mIngestion summary\u001b[0m \u001b[94m│\u001b[0m\r\n\u001b[94m╰───────────────────╯\u001b[0m\r\n"]
[23.264602, "o", "\u001b[1;32m✓\u001b[0m Dry run complete (8/8 steps): the configuration is valid, and nothing was changed.\r\n"]
